JAN20

# I visualize the images together to see the differences (+ one next to the other, / one under the other)
OCT19/JAN20

# the function names allows me to find out the names of the layers
names(October19)
names(January20)

# in this way I can analysis ndvi = The Normalized Difference Vegetation Index (NDVI) is a standard remote-sensing metric used to quantify the health and density of vegetation
nir2019 <- October19$October2019.KI_1
red2019 <- October19$October2019.KI_2
green2019 <- October19$October2019.KI_3

ndvi2019 <- (nir2019-red2019)/(nir2019+red2019)

nir2020 <- January20$January2020KI_1
red2020 <- January20$January2020KI_2

ndvi2020 <- (nir2020-red2020)/(nir2020+red2020)

# Visualize the images created together, showing the different ndvi in 2019 and in 2020
par(mfrow=c(2,1))
plot(ndvi2019)
plot(ndvi2020)

# If I wanna change the colours for a better visualization
cl <- colorRampPalette(c("black","white","red","magenta","green"))(100)
plot(ndvi2019,col=cl)
plot(ndvi2020,col=cl)

# create a pdf comoaring real images and ndvi
pdf("Island 2019 vs 2020 ndvi", width=8, height=6)
par(mfrow=c(2,2))
plotRGB(October19,1,2,3)
plotRGB(January20,1,2,3)
plot(ndvi2019)
plot(ndvi2020)
dev.off()

# Standard Deviation = a statistical measure of how spread out the values in a dataset are from the average (mean). It tells you, on average, how far each individual data point deviates from the mean. 

# I could need to calculate the Standard deviation for different variables: ndvi, nir band…
# I choose a matrix of 7x7 in this case
ndvisd_2019.7 <- focal(ndvi2019, w=matrix(1/49, nrow=7, ncol=7), fun=sd)
ndvisd_2020.7 <- focal(ndvi2020, w=matrix(1/49, nrow=7, ncol=7), fun=sd)

# visualize together
par(mfrow=c(2,1))
plot(ndvisd_2019.7)
plot(ndvisd_2020.7)

# PCA needed for multivariate analysis. It allows me to understand how many infos are contained in the different layers. It can be usefull to know which one I should select for my analysis
October19.pca <- rasterPCA(October19)
October19.pca
summary(October19.pca$model)
plot(October19.pca$map)

January20.pca <- rasterPCA(January20)
January20.pca
summary(January20.pca$model)
plot(January20.pca$map)

# in this case, I could calculate sd even for PC1, so only for the first layer
# I can plot PC1 of the two images together to see the differnces
plot(October19.pca$map$PC1)
plot(January20.pca$map$PC1)

